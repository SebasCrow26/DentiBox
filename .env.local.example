# Copia este archivo a .env.local y llena los valores reales.
# (Project Settings → API en Supabase; Dashboard en Cloudinary)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# CLOUDINARY_API_SECRET debe quedarse solo en el servidor — nunca le pongas
# el prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# URL del sitio en producción, para metadatos/sitemap.
NEXT_PUBLIC_SITE_URL=https://dentibox.pages.dev
